{
  "name": "marker-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "backup": "node --import tsx scripts/backup.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration.ts",
    "qa": "npm run build && node --import tsx scripts/qa.ts",
    "perf:sketch": "npm run build && node --import tsx scripts/perf-sketch.ts",
    "seed:teams": "node --import tsx scripts/seed-teams.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/static": "^10.1.8",
    "@fontsource/caveat": "^5.2.0",
    "@fontsource/neucha": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "description": "Личная Kanban-доска с бумажными стикерами, обзором дня и локальным хранением в SQLite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vadim-Bogdanchik/marker-board.git"
  },
  "homepage": "https://github.com/Vadim-Bogdanchik/marker-board#readme",
  "bugs": {
    "url": "https://github.com/Vadim-Bogdanchik/marker-board/issues"
  }
}
